# Скопируйте в server/.env и заполните

# Порт сервера
PORT=3000

# Токен для просмотра заявок на странице admin.html (придумайте длинную строку)
ADMIN_TOKEN=

# Уведомления о заявках в Telegram: создайте бота через @BotFather,
# получите chat_id (например, через @userinfobot) и вставьте сюда
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
